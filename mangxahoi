<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090b10">
<title>Hoàng Phi — Personal Space</title>
<style>
:root{color-scheme:dark;--glass:rgba(255,255,255,.085);--line:rgba(255,255,255,.12);--muted:#a7adba}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif;color:#f7f8fc;background:radial-gradient(ellipse at 50% 0%,#34415d 0%,#171e2b 35%,#090b10 75%);display:flex;align-items:center;justify-content:center;padding:28px 16px}
.wrap{width:min(100%,430px);text-align:center}
.status{display:flex;justify-content:space-between;font-size:13px;font-weight:650;padding:0 8px;margin-bottom:38px;color:#f5f6fa}
.avatar{width:104px;height:104px;border-radius:32px;margin:0 auto 20px;display:grid;place-items:center;background:linear-gradient(145deg,#66758e,#222b3a);border:1px solid #ffffff35;box-shadow:0 18px 50px #0008;font-size:42px}
h1{font-size:30px;letter-spacing:3px;margin:0 0 8px;font-weight:750}
.tag{font-size:11px;letter-spacing:3px;color:#aeb9cb;margin-bottom:14px}
.bio{color:#d8dce5;font-size:14px;margin:0 0 30px}
.links{display:grid;gap:12px}
.link{display:flex;align-items:center;gap:14px;text-align:left;text-decoration:none;color:#fff;padding:16px 17px;border:1px solid var(--line);background:var(--glass);border-radius:20px;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);transition:transform .18s,background .18s}
.link:active{transform:scale(.975);background:#ffffff20}
.symbol{width:42px;height:42px;border-radius:14px;background:#ffffff17;display:grid;place-items:center;font-size:21px}
.label{font-weight:650;font-size:15px}
.handle{font-size:12px;color:var(--muted);margin-top:3px}
.arrow{margin-left:auto;color:#aeb6c4;font-size:22px}
.footer{margin-top:28px;color:#818b9b;font-size:11px;letter-spacing:1px}
.note{margin:22px auto 0;color:#929bab;font-size:11px;line-height:1.5;max-width:330px}
@media(prefers-reduced-motion:no-preference){.wrap{animation:rise .7s ease both}@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}}
</style>
</head>
<body>
<main class="wrap">
  <div class="status"><span>9:41</span><span>●●●　◖　▰</span></div>
  <div class="avatar" aria-hidden="true">✦</div>
  <h1>HOÀNG PHI</h1>
  <div class="tag">PERSONAL SPACE · 2026</div>
  <p class="bio">Welcome to my little world ✨</p>
  <nav class="links" aria-label="Mạng xã hội">
