      <span class="symbol">♪</span><span><div class="label">TikTok</div><div class="handle">@h.phi1907</div></span><span class="arrow">›</span>
    </a>
    <a class="link" href="https://www.instagram.com/hoangphi.2009/" target="_blank" rel="noopener noreferrer">
      <span class="symbol">◎</span><span><div class="label">Instagram</div><div class="handle">@hoangphi.2009</div></span><span class="arrow">›</span>
    </a>
    <a class="link" href="https://www.facebook.com/hoang.phi.791825" target="_blank" rel="noopener noreferrer">
      <span class="symbol">f</span><span><div class="label">Facebook</div><div class="handle">Hoàng Phi</div></span><span class="arrow">›</span>
    </a>
    <a class="link" href="https://zalo.me/0387129701" target="_blank" rel="noopener noreferrer">
      <span class="symbol">Z</span><span><div class="label">Zalo</div><div class="handle">Contact me</div></span><span class="arrow">›</span>
    </a>
  </nav>
  <div class="footer">MADE WITH ♡ · HOÀNG PHI</div>
  <p class="note">Trang cá nhân chính thức của Hoàng Phi. Chạm vào từng mục để mở hồ sơ mạng xã hội.</p>
</main>
</body>
</html>
